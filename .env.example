# ==========================================
# SafeSpace AI Mental Health Therapist Configuration
# ==========================================

# Groq Cloud API Key (Free tier from console.groq.com)
GROQ_API_KEY=""

# Model Selection: llama-3.3-70b-versatile, llama-3.1-8b-instant, or gemma2-9b-it
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional: OpenAI API Key (fallback if desired)
OPENAI_API_KEY=""

# Optional: Ollama URL (if running locally: http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="alibayram/medgemma:4b"

# Active LLM Provider: "groq", "ollama", "openai", or "simulation"
DEFAULT_PROVIDER="groq"

# Twilio Emergency Calling & SMS (Optional - has simulated dry-run if blank)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
EMERGENCY_CONTACT=""

# Server Settings
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
